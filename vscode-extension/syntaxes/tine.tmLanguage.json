{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Tine",
    "scopeName": "source.tine",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#modules"
        },
        {
            "include": "#markup"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#types"
        },
        {
            "include": "#booleans"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "markup": {
            "patterns": [
                {
                    "include": "#markup-element"
                }
            ]
        },
        "markup-element": {
            "name": "meta.tag.tine",
            "begin": "(</?)([A-Za-z][A-Za-z0-9_-]*)",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.begin.tine"
                },
                "2": {
                    "name": "entity.name.tag.tine"
                }
            },
            "end": "/?>",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.tag.end.tine"
                }
            },
            "patterns": [
                {
                    "include": "#markup-type-arguments"
                },
                {
                    "include": "#markup-attributes"
                }
            ]
        },
        "markup-type-arguments": {
            "begin": "<",
            "end": ">",
            "name": "meta.type.parameters.tine",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.type.begin.tine"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.type.end.tine"
                }
            },
            "patterns": [
                {
                    "include": "#types"
                },
                {
                    "match": ",",
                    "name": "punctuation.separator.type.tine"
                }
            ]
        },
        "markup-attributes": {
            "patterns": [
                {
                    "match": "([A-Za-z_:][A-Za-z0-9_:.\\-]*)(\\s*=)",
                    "captures": {
                        "1": {
                            "name": "entity.other.attribute-name.tine"
                        },
                        "2": {
                            "name": "keyword.operator.assignment.tine"
                        }
                    }
                },
                {
                    "begin": "\"",
                    "end": "\"",
                    "name": "string.quoted.double.tine",
                    "patterns": [
                        {
                            "include": "#string-escapes"
                        }
                    ]
                },
                {
                    "begin": "'",
                    "end": "'",
                    "name": "string.quoted.single.tine",
                    "patterns": [
                        {
                            "include": "#string-escapes"
                        }
                    ]
                },
                {
                    "begin": "\\{",
                    "end": "\\}",
                    "name": "meta.embedded.expression.tine",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.section.embedded.begin.tine"
                        }
                    },
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.section.embedded.end.tine"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#expressions"
                        }
                    ]
                }
            ]
        },
        "expressions": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#markup"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#functions"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#booleans"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#identifiers"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "entity.name.type.tine",
                    "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
                },
                {
                    "name": "entity.name.type.tine",
                    "match": "\\b(str|int|float|bool)\\b"
                }
            ]
        },
        "booleans": {
            "name": "constant.language.boolean.tine",
            "match": "\\b(true|false)\\b"
        },
        "functions": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_$]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.call.tine"
                        }
                    }
                },
                {
                    "begin": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.function.tine"
                        }
                    },
                    "end": "(?=\\()",
                    "patterns": [
                        {
                            "include": "#function-type-parameters"
                        }
                    ]
                }
            ]
        },
        "function-type-parameters": {
            "begin": "<",
            "end": ">",
            "name": "meta.type.parameters.tine",
            "patterns": [
                {
                    "include": "#types"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.tine",
                    "match": "\\b(if|else|for|in|return|break|continue|match|use)\\b"
                },
                {
                    "name": "keyword.declaration.variable.tine",
                    "match": "\\b(let|mut)\\b"
                },
                {
                    "name": "keyword.declaration.type.tine",
                    "match": "\\b(struct|enum)\\b"
                },
                {
                    "name": "keyword.declaration.function.tine",
                    "match": "\\b(fn|impl|static)\\b"
                },
                {
                    "name": "keyword.modifier.visibility.tine",
                    "match": "\\b(pub)\\b"
                }
            ]
        },
        "identifiers": {
            "name": "variable.other.tine",
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_$]*\\b"
        },
        "modules": {
            "begin": "(use)\\s+\\.*",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.tine"
                }
            },
            "end": "\\n",
            "patterns": [
                {
                    "name": "entity.name.namespace.tine",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_$]*\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.tine",
                    "match": "(?<![\\w.])[0-9]+\\.[0-9]*(?:[eE][+-]?[0-9]+)?"
                },
                {
                    "name": "constant.numeric.integer.hexadecimal.tine",
                    "match": "\\b0x[0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.integer.binary.tine",
                    "match": "\\b0b[01]+\\b"
                },
                {
                    "name": "constant.numeric.integer.decimal.tine",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.tine",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "include": "#string-escapes"
                }
            ]
        },
        "string-escapes": {
            "name": "constant.character.escape.tine",
            "match": "\\\\."
        },
        "comments": {
            "name": "comment.line.double-slash.tine",
            "begin": "//",
            "end": "$"
        }
    }
}