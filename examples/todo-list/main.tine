use dom.render
use signals.{state, computed$}

let mut nextId = 0

// This comment should become documentation for Todo type
struct Todo {
    id:   int
    task: str
    done: bool
}

let defaultTodo = Todo {
    id:   nextId,
    task: "Add more todos",
    done: false
}

let todos = state([defaultTodo])

fn removeTodo(id: int) {
    *todos = todos.filter(fn(todo) todo.id != id)
}

fn renderTodo(todo: Todo) -> Element {
    fn removeSelf() {
        removeTodo(todo.id)
    }

    <div class="todo">
        <input class="todo-done" type="checkbox" checked={todo.done} />
        <span class="todo-text">{todo.task}</span>
        <button class="todo-delete" onclick={removeSelf}> × </button>
    </div>
}

let list = computed$(todos.map(renderTodo))

let todoForm = {
    let input = state("")
    let disabled = computed$(*input == "")

    fn validate() {
        if *input == "" { return }
        nextId = nextId + 1
        todos.push(Todo {
            id:   nextId,
            task: *input,
            done: false,
        })
        *input = ""
    }

    <div id="todo-form">
        <input class="todo-input" value={input} placeholder="Write something to do" />
        <button onclick={validate} disabled={disabled}>Ajouter</button>
    </div>
}

let app = <div id="app">
    <h1>Things to do</h1>
    {todoForm}
    <div class="todo-list">
        {list}
    </div>
</div>

render("body", app)