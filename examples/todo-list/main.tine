use dom.render
use signals.{state, computed$}

let mut nextId = 0

// This comment should become documentation for Todo type
struct Todo {
    id:   int
    task: str
    done: bool
}

let defaultTodo = Todo {
    id:   nextId,
    task: "Add more todos",
    done: false
}

let todos = state([defaultTodo])

fn renderTodo(todo: Todo) -> Element {
    <div>
        <input type="checkbox" checked={todo.done} />
        <span class="task">{todo.task}</span>
    </div>
}

let list = computed$(todos.map(renderTodo))

let todoForm = {
    let input = state("")
    let disabled = computed$(*input == "")

    fn validate() {
        if *input == "" {
            return
        }
        nextId = nextId + 1
        todos.push(Todo {
            id:   nextId,
            task: *input,
            done: false,
        })
        *input = ""
    }

    <div>
        <input value={input} />
        <button onclick={validate} disabled={disabled}>Ajouter</button>
    </div>
}

let app = <div>
    {list}
    {todoForm}
</div>

render("body", app)